<Window x:Class="Atypik.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="A'Tipik"
        Width="460" Height="600"
        MinWidth="400" MinHeight="520"
        ResizeMode="CanMinimize"
        Background="{StaticResource BrBgDeep}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <!-- Accent top border - brand violet gradient -->
    <LinearGradientBrush x:Key="BrHeaderGradient" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FF3A1070" Offset="0"/>
      <GradientStop Color="#FF5E1FA8" Offset="0.45"/>
      <GradientStop Color="#FFA77BD8" Offset="1"/>
    </LinearGradientBrush>
  </Window.Resources>

  <DockPanel>

    <!--  ++ MENU BAR ++++++++++++++++++++++++++++++++++++++++++++++  -->
    <Menu DockPanel.Dock="Top">
      <MenuItem x:Name="MenuFile" Header="_File">
        <MenuItem x:Name="MenuNewFrame" Header="New frame"  Click="OnNewFrame"/>
        <Separator/>
        <MenuItem x:Name="MenuQuit"     Header="Quit"       Click="OnQuit"/>
      </MenuItem>
      <MenuItem x:Name="MenuEdit" Header="_Edit">
        <MenuItem x:Name="MenuSettings"   Header="Settings…"   Click="OnSettings"/>
        <MenuItem x:Name="MenuExtensions" Header="Extensions…" Click="OnExtensions"/>
      </MenuItem>
      <MenuItem x:Name="MenuAbout" Header="_About">
        <MenuItem x:Name="MenuAboutApp" Header="About A-typik…"  Click="OnAbout"/>
        <Separator/>
        <MenuItem x:Name="MenuLicense"  Header="License &amp; Terms" Click="OnLicense"/>
      </MenuItem>
    </Menu>

    <!--  ++ MAIN CONTENT ++++++++++++++++++++++++++++++++++++++++++  -->
    <StackPanel DockPanel.Dock="Top" Margin="0">

      <!--  Accent stripe  -->
      <Rectangle Height="3" Fill="{StaticResource BrHeaderGradient}"/>

      <!-- Logo + titre (centrés) -->
      <Border Background="#FF160E24" Padding="28,24,28,20">
        <StackPanel HorizontalAlignment="Center">
          <!-- Monogramme de l'application, centré -->
          <Image Source="pack://siteoforigin:,,,/assets/logo-ico.png"
                 Width="76" Height="76"
                 HorizontalAlignment="Center"
                 Margin="0,0,0,10"
                 RenderOptions.BitmapScalingMode="HighQuality"/>

          <!-- Wordmark "A'TIPIK" - quasi-runic angular letterforms drawn as native
               WPF vectors (crisp at any DPI), with nodes echoing the logo graph. -->
          <Viewbox Height="36" HorizontalAlignment="Center">
            <Canvas Width="232" Height="64">
              <Canvas.Resources>
                <LinearGradientBrush x:Key="Wg" StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#FF7C36CC" Offset="0"/>
                  <GradientStop Color="#FFA77BD8" Offset="0.5"/>
                  <GradientStop Color="#FFC9A9F0" Offset="1"/>
                </LinearGradientBrush>
              </Canvas.Resources>
              <Path Stroke="{StaticResource Wg}" StrokeThickness="6" Data="M10,56 L28,8 L46,56"/>
              <Path Stroke="{StaticResource Wg}" StrokeThickness="6" Data="M18,38 L38,38"/>
              <Path Stroke="{StaticResource Wg}" StrokeThickness="6" Data="M58,8 L52,22"/>
              <Path Stroke="{StaticResource Wg}" StrokeThickness="6" Data="M66,8 L104,8"/>
              <Path Stroke="{StaticResource Wg}" StrokeThickness="6" Data="M85,8 L85,56"/>
              <Path Stroke="{StaticResource Wg}" StrokeThickness="6" Data="M116,8 L116,56"/>
              <Path Stroke="{StaticResource Wg}" StrokeThickness="6" Data="M128,56 L128,8 L160,21 L128,34"/>
              <Path Stroke="{StaticResource Wg}" StrokeThickness="6" Data="M172,8 L172,56"/>
              <Path Stroke="{StaticResource Wg}" StrokeThickness="6" Data="M184,8 L184,56"/>
              <Path Stroke="{StaticResource Wg}" StrokeThickness="6" Data="M184,33 L216,8"/>
              <Path Stroke="{StaticResource Wg}" StrokeThickness="6" Data="M184,33 L216,56"/>
              <Ellipse Canvas.Left="24"  Canvas.Top="4"  Width="8" Height="8" Fill="#FFE8DAFB"/>
              <Ellipse Canvas.Left="81"  Canvas.Top="4"  Width="8" Height="8" Fill="#FFE8DAFB"/>
              <Ellipse Canvas.Left="156" Canvas.Top="17" Width="8" Height="8" Fill="#FFE8DAFB"/>
              <Ellipse Canvas.Left="180" Canvas.Top="29" Width="8" Height="8" Fill="#FFE8DAFB"/>
              <Ellipse Canvas.Left="212" Canvas.Top="52" Width="8" Height="8" Fill="#FFE8DAFB"/>
            </Canvas>
          </Viewbox>

          <TextBlock x:Name="AppSubtitle" Style="{StaticResource SubStyle}"
                     HorizontalAlignment="Center" TextAlignment="Center"
                     Margin="0,4,0,0">
            a behavioural normaliser
          </TextBlock>
        </StackPanel>
      </Border>

      <!-- Tutoriel (dismissible) -->
      <Border x:Name="TutorialCard"
              Background="#FF1F1530"
              BorderBrush="{StaticResource BrWarnYellow}"
              BorderThickness="0,0,0,2"
              Padding="20,14,20,14"
              Margin="0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock x:Name="TutorialTitle"
                       Foreground="{StaticResource BrWarnYellow}"
                       FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6">
              ⚡ Getting started
            </TextBlock>

            <TextBlock x:Name="TutorialBody"
                       Style="{StaticResource BodyStyle}" FontSize="11.5"
                       LineHeight="18">
              <Run FontWeight="SemiBold" Foreground="{StaticResource BrTextPrimary}">1.</Run>
              <Run> Click </Run>
              <Run FontWeight="Bold" Foreground="{StaticResource BrAccentPurple}">New frame</Run>
              <Run> and draw a rectangle around the target input area.</Run>
              <LineBreak/><LineBreak/>
              <Run FontWeight="SemiBold" Foreground="{StaticResource BrTextPrimary}">2.</Run>
              <Run> Type your text in the overlay - A-typik captures it locally.</Run>
              <LineBreak/><LineBreak/>
              <Run FontWeight="SemiBold" Foreground="{StaticResource BrTextPrimary}">3.</Run>
              <Run> Press </Run>
              <Run FontWeight="Bold" Foreground="{StaticResource BrAccentTeal}">Enter</Run>
              <Run> to inject with a natural behavioural signature (Shift+Enter for a newline).</Run>
            </TextBlock>

            <!-- Warning box -->
            <Border Background="#FF261A30"
                    BorderBrush="{StaticResource BrAccentOrange}"
                    BorderThickness="2" CornerRadius="6"
                    Padding="10,7" Margin="0,10,0,0">
              <TextBlock x:Name="TutorialWarning"
                         Style="{StaticResource BodyStyle}" FontSize="11">
                <Run Foreground="{StaticResource BrAccentOrange}" FontWeight="Bold">⚠ Important - </Run>
                <Run>Do not include buttons, menus or interactive controls of the target app inside the frame.</Run>
                <LineBreak/>
                <Run>They must remain directly clickable.</Run>
              </TextBlock>
            </Border>
          </StackPanel>

          <!--  Bouton fermer le tutoriel  -->
          <Button Grid.Column="1"
                  Content="✕"
                  VerticalAlignment="Top"
                  Background="Transparent"
                  Foreground="{StaticResource BrTextMuted}"
                  BorderThickness="0"
                  FontSize="14" Cursor="Hand"
                  Margin="10,0,0,0"
                   Click="OnDismissTutorial"
                   ToolTip="Don't show again"/>
        </Grid>
      </Border>

      <!--    3 boutons principaux    -->
      <Border Padding="24,20" Background="{StaticResource BrBgDeep}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!--  1 - New frame  -->
          <Button Grid.Column="0"
                  Style="{StaticResource IconBtn}"
                  Click="OnNewFrame"
                  HorizontalAlignment="Center"
                  x:Name="BtnNewFrame"
                  ToolTip="Draw a capture frame on the target application">
            <StackPanel HorizontalAlignment="Center">
              <!--  Frame icon - Segoe MDL2 Assets  -->
              <TextBlock Text="&#xE7C5;"
                         FontFamily="Segoe MDL2 Assets"
                         FontSize="32"
                         HorizontalAlignment="Center"
                         Foreground="{StaticResource BrAccentPurple}"/>
              <TextBlock x:Name="BtnNewFrameLabel" Text="New" FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource BrTextPrimary}"
                         HorizontalAlignment="Center"
                         Margin="0,6,0,0"/>
              <TextBlock x:Name="BtnNewFrameSub" Text="frame" FontSize="10"
                         Foreground="{StaticResource BrTextMuted}"
                         HorizontalAlignment="Center"/>
            </StackPanel>
          </Button>

          <!--  2 - Settings  -->
          <Button Grid.Column="1"
                  Style="{StaticResource IconBtn}"
                  Click="OnSettings"
                  HorizontalAlignment="Center"
                  x:Name="BtnSettings"
                  ToolTip="Behaviour options and model configuration">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="&#xE713;"
                         FontFamily="Segoe MDL2 Assets"
                         FontSize="32"
                         HorizontalAlignment="Center"
                         Foreground="{StaticResource BrAccentTeal}"/>
              <TextBlock x:Name="BtnSettingsLabel" Text="Settings" FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource BrTextPrimary}"
                         HorizontalAlignment="Center"
                         Margin="0,6,0,0"/>
              <TextBlock x:Name="BtnSettingsSub" Text="&amp; options" FontSize="10"
                         Foreground="{StaticResource BrTextMuted}"
                         HorizontalAlignment="Center"/>
            </StackPanel>
          </Button>

          <!--  3 - Extensions  -->
          <Button Grid.Column="2"
                  Style="{StaticResource IconBtn}"
                  Click="OnExtensions"
                  HorizontalAlignment="Center"
                  x:Name="BtnExtensions"
                  ToolTip="Add Python scripts, MCP modules, custom behaviours">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="&#xECAA;"
                         FontFamily="Segoe MDL2 Assets"
                         FontSize="32"
                         HorizontalAlignment="Center"
                         Foreground="{StaticResource BrAccentOrange}"/>
              <TextBlock x:Name="BtnExtensionsLabel" Text="Extensions" FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource BrTextPrimary}"
                         HorizontalAlignment="Center"
                         Margin="0,6,0,0"/>
              <TextBlock x:Name="BtnExtensionsSub" Text="&amp; scripts" FontSize="10"
                         Foreground="{StaticResource BrTextMuted}"
                         HorizontalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- Separator -->
      <Rectangle Height="1" Fill="{StaticResource BrBorderSubtle}" Margin="24,0"/>

      <!-- Model status -->
      <Border Padding="24,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock x:Name="ModelSectionLabel"
                       Text="Correction model"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource BrTextMuted}"/>
            <TextBlock x:Name="ModelStatusText"
                       Text="No model loaded"
                       FontSize="12"
                       Foreground="{StaticResource BrTextPrimary}"
                       Margin="0,2,0,0"/>
          </StackPanel>

          <!--  Status indicator  -->
          <Ellipse x:Name="ModelIndicator"
                   Grid.Column="1"
                   Width="10" Height="10"
                   Fill="#FF444466"
                   VerticalAlignment="Center"
                   ToolTip="Model status"/>
        </Grid>
      </Border>

    </StackPanel>

    <!-- STATUS BAR -->
    <Border DockPanel.Dock="Bottom"
            Background="{StaticResource BrBgDeep}"
            BorderBrush="{StaticResource BrBorderSubtle}"
            BorderThickness="0,1,0,0"
            Padding="16,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText"
                   Grid.Column="0"
                   Text="Ready"
                   FontSize="11"
                   Foreground="{StaticResource BrTextMuted}"/>
        <TextBlock Grid.Column="1"
                   Text="© Hope 'n Mind SASU · SIREN 938 261 310"
                   FontSize="10"
                   Foreground="{StaticResource BrTextSubtle}"/>
      </Grid>
    </Border>

  </DockPanel>
</Window>
